# =============================================================================
# DeadlineIQ Backend Production Environment Variables Template
# =============================================================================
# Copy to .env for local testing or inject directly into your production host
# (Render / Railway / AWS / Heroku / GCP) environment variables panel.
#
# IMPORTANT: Never commit actual secret keys or database passwords to Git.
# =============================================================================

# Server Port (Cloud providers typically inject PORT dynamically)
PORT=8080

# CORS Allowed Origin Patterns (Comma-separated)
CORS_ALLOWED_ORIGIN_PATTERNS=https://deadline-frontend-o4h7n5uer-deadline-22ac.vercel.app,https://*.vercel.app,http://localhost:*

# Google Gemini Generative AI
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=chatbot
PINECONE_NAMESPACE=default

# Production MySQL Database (e.g. Railway MySQL, AWS RDS, PlanetScale, Aiven)
DATABASE_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/deadlineiq?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=
DATABASE_PASSWORD=
